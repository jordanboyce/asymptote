# Asymptote — on-premises configuration.
#
#   cp .env.onprem.example .env
#   docker compose -f docker-compose.onprem.yml up -d
#
# Everything a site changes lives here; the image itself is identical
# everywhere. Full walkthrough in docs/ONPREM.md. This file covers the
# on-prem essentials — .env.example documents every setting the app has.


# ── The image ────────────────────────────────────────────────────────────
# What was loaded (`docker load < asymptote-image.tar.gz`) or what your
# internal registry serves. Pin a digest instead of a tag if you need to
# prove that what runs is what was reviewed:
#   ASYMPTOTE_IMAGE=registry.internal/asymptote@sha256:abc123...
ASYMPTOTE_IMAGE=asymptote:local
# "never" = never reach out to a registry (correct for an air gap).
# Use "missing" when pulling from an internal registry.
ASYMPTOTE_PULL_POLICY=never


# ── The model ────────────────────────────────────────────────────────────
# The LLM this deployment uses for everyone. Set it and nobody has to
# configure a provider in their own browser: chat, report generation, image
# and scanned-page OCR, and the content-policy reviewer all use it.
#
# A per-request key still overrides it, so someone can bring their own.
#
#   openai_compatible   any OpenAI-shaped server you run — vLLM, LM Studio,
#                       llama.cpp, TGI, LiteLLM, Ollama's /v1, a gateway
#   ollama              an Ollama daemon (native API)
#   anthropic openai google grok github openrouter ollama_cloud
#                       a hosted provider (needs OFFLINE_MODE=false)
AI_PROVIDER=openai_compatible

# The endpoint. Required for openai_compatible; include the /v1 suffix if
# your server serves the OpenAI routes under one.
#   http://vllm.internal:8000/v1
#   https://llm.corp.example/v1
#   http://host.docker.internal:11434/v1     (Ollama on this Docker host)
AI_BASE_URL=http://vllm.internal:8000/v1

# The model to ask for. Whatever your endpoint calls it.
AI_MODEL=llama-3.3-70b-instruct

# Credential for the endpoint. Leave empty for a server that needs none.
AI_API_KEY=

# What people see in the UI instead of "openai_compatible".
AI_PROVIDER_LABEL=Acme Internal LLM

# For AI_PROVIDER=ollama, or Ollama-served embeddings. From inside the
# container, the Docker host is host.docker.internal (the compose file maps
# it); another machine on the network works too.
OLLAMA_BASE_URL=http://host.docker.internal:11434


# ── Egress ───────────────────────────────────────────────────────────────
# 1 = cloud AI providers and all model downloads are refused. Only the
# endpoints configured above are ever contacted. Requires an image built
# with --build-arg OFFLINE_BUNDLE=1 if you want the reranker, audio
# transcription or local OCR, since those models cannot be fetched later.
OFFLINE_MODE=1

# Where documents and queries become search vectors. "local" runs in this
# container on CPU and is the only option that sends nothing anywhere.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Outbound proxy, if this network requires one. NO_PROXY should list your
# model endpoint so its traffic stays internal.
# HTTP_PROXY=http://proxy.internal:3128
# HTTPS_PROXY=http://proxy.internal:3128
# NO_PROXY=localhost,127.0.0.1,.internal,host.docker.internal


# ── Access ───────────────────────────────────────────────────────────────
# By default everyone who can reach the port reads the whole corpus — the
# right model for a team appliance, the wrong one for an agency. Set a long
# random password whenever the port is reachable beyond this machine;
# browsers prompt for it natively and API/MCP clients send it as
# `Authorization: Bearer <password>`.
AUTH_PASSWORD=


# ── Per-person collections ───────────────────────────────────────────────
# Collections belong to the person who created them and are invisible to
# everyone else until shared; everything indexed before the flag stays a
# shared team collection. Needs a verified identity on every request, which
# today means Cloudflare Access (CF_ACCESS_TEAM_DOMAIN + CF_ACCESS_AUD) in
# front of the deployment — see docs/DEPLOYMENT.md. The app refuses to start
# with the flag on and no identity source.
# PRIVATE_COLLECTIONS=true

# Acceptable-use acknowledgement, recorded per identity.
# AUP_REQUIRED=true

# How long the audit trail is kept. 0 = forever.
# AUDIT_RETENTION_DAYS=365

# Serve the app under a hostname rather than localhost? List it, or the MCP
# SDK's DNS-rebinding protection refuses agent connections.
# MCP_ALLOWED_HOSTS=asymptote.internal

# Which interface the published port binds to. 127.0.0.1 (the default)
# means this machine only; 0.0.0.0 means the network — pair that with
# AUTH_PASSWORD or an authenticating reverse proxy.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8473

# Where the corpus lives on this host. A named volume (DATA_PATH=asymptote-data
# plus a top-level volumes: entry) is more reliable than a bind mount on
# Windows hosts, where SQLite WAL files misbehave under write load.
DATA_PATH=./data

# Serve HTTPS directly instead of terminating TLS at a proxy. Paths are
# inside the container — mount the pair into the container first.
# SSL_CERTFILE=/certs/tls/server.crt
# SSL_KEYFILE=/certs/tls/server.key


# ── Limits ───────────────────────────────────────────────────────────────
# Per-collection storage cap in bytes (0 = unlimited). Default 5 GiB.
# COLLECTION_STORAGE_LIMIT_BYTES=5368709120

# Per-identity request budgets. A self-hosted model has finite capacity;
# these keep one person from monopolising it.
# RATE_LIMIT_CHAT_PER_MINUTE=6
# RATE_LIMIT_SEARCH_PER_MINUTE=30
