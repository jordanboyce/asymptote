# Finn API Dockerfile (Corporate)
# For environments requiring custom SSL certificates (corporate proxies, internal CAs)

FROM python:3.13-slim as base

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy and install corporate SSL certificates
# Place your .crt files in the certs/ directory before building
COPY certs/*.crt /usr/local/share/ca-certificates/
RUN update-ca-certificates

# Configure Python and tools to use system CA certificates
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Presidio's default NLP engine loads en_core_web_lg at runtime and pip does
# not bring it in -- requirements.txt mentions it only in a comment. Without
# this line the image builds and starts cleanly, then raises on the first
# redaction. Redaction then fails open
# (services/privacy/redaction_middleware.py), so client PII reaches the model
# while /health and the UI still report the boundary as enforcing. Keep this
# in lockstep with the main Dockerfile.
RUN python -m spacy download en_core_web_lg

# Copy application code
COPY . .

# Create data directory
RUN mkdir -p /app/data/documents /app/data/indexes

# Expose port
EXPOSE 8000

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV DATA_DIR=/app/data

ENV PORT=8000

# Bind the port the platform assigns. A hardcoded 8000 makes the service
# unreachable on Railway / Render / Fly / Cloud Run, which inject $PORT and
# route to that alone -- the container looks healthy and every request 502s at
# the edge. Mirrors the main Dockerfile.
CMD ["sh", "-c", "exec uvicorn main:app --host ${HOST:-0.0.0.0} --port ${PORT:-8000}"]
