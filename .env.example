# Finn API Configuration

# Data storage directory (where documents and indexes are stored)
DATA_DIR=./data

# Embedding model (from sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Text chunking configuration
CHUNK_SIZE=550
CHUNK_OVERLAP=100

# Search configuration
DEFAULT_TOP_K=10
MAX_TOP_K=50

# Server configuration
HOST=0.0.0.0
PORT=8000

# ========================================
# Access control
# ========================================
# Finn has NO built-in login. Single-user mode (the default) assumes the app
# is reachable only by you — a local run, or a LAN you trust. Do not put this
# on a public URL without an authenticating proxy in front of it.
#
# Multi-user mode gives each person their own isolated collections. Identity
# comes from that proxy; see DEPLOYMENT.md for the Cloudflare Access runbook.
ENABLE_MULTI_USER=false

# Cloudflare Access. Set BOTH to authenticate users by verified JWT signature
# — the only option here that holds up if the origin is ever reachable
# directly. Team domain accepts "acme", "acme.cloudflareaccess.com", or a URL.
# The AUD tag is in Zero Trust > Access > Applications > your app >
# Additional settings > Application Audience (AUD) Tag.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Only for a non-Access proxy (oauth2-proxy, Authelia, Traefik forward-auth)
# that can supply X-User-ID but not an Access JWT. Leave false unless you are
# certain the origin cannot be reached except through that proxy: with this
# on, a plain header is enough to assert any identity.
TRUST_PROXY_USER_HEADER=false

# CORS. "*" is right for a local app. When hosting, pin it to the exact
# origin(s) the browser loads the app from — a wildcard plus credentials lets
# any website drive this API as the logged-in user.
# e.g. CORS_ALLOW_ORIGINS=https://finn.example.com
CORS_ALLOW_ORIGINS=*

# ========================================
# v3.0 Features
# ========================================

# OCR Configuration (for scanned PDF support)
# Requires: pip install pytesseract pdf2image pillow
# Also requires Tesseract OCR installed on system
ENABLE_OCR=false
OCR_ENGINE=pytesseract  # pytesseract or easyocr
OCR_LANGUAGE=eng        # Tesseract language codes, e.g., "eng+fra" for English+French
OCR_FALLBACK_ONLY=true  # Only use OCR when text extraction fails/returns empty

# CSV Indexing Configuration
CSV_ROW_LEVEL_INDEXING=true  # Index CSV rows individually for better search
CSV_ROWS_PER_CHUNK=5         # Rows per chunk when row-level indexing is disabled

# MCP server
ENABLE_MCP=true
MCP_SERVER_ID=finn
MCP_DEFAULT_COLLECTION=default
MCP_TOP_K=5
MCP_MODE=semantic
MCP_SEMANTIC_WEIGHT=0.7
MCP_INCLUDE_SOURCES=true
MCP_MAX_SOURCE_LENGTH=500
MCP_AI_PROVIDER=none
MCP_OLLAMA_MODEL=gemma3n

# ========================================
# Feedback / issue reporting (optional)
# ========================================
# When set, the in-app "Report issue" button emails reports (with a
# PII-redacted diagnostics snapshot) via Resend (https://resend.com).
# Leave RESEND_API_KEY empty to disable; the UI will show a hint.
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=jordan.boyce@cyberlion.dev
# Optional override for the From line. Empty = use Resend's
# onboarding@resend.dev sandbox sender (works without a verified domain).
FEEDBACK_EMAIL_FROM=

# ========================================
# Hosted-mode fallback key (optional)
# ========================================
# Lets an advisor chat without pasting their own API key: any request that
# arrives with no X-AI-Key header and no stored key is routed through this
# one instead. This is the beta-billing path — you pay, they don't.
#
# THIS MUST BE AN ollama.com KEY. The fallback always constructs an
# `ollama_cloud` provider (main.py, _build_ai_provider_from_headers), so an
# Anthropic or OpenAI key put here is sent to ollama.com and comes back 401
# with nothing in the UI to explain why. Anthropic/OpenAI keys belong on the
# request (X-AI-Key, which is what the in-app key prompt sends) or in the
# per-provider store via POST /api/agent/config — never here.
#
# Leave empty for self-hosted / BYO-key installs; behaviour is unchanged when
# it is blank.
FALLBACK_API_KEY=
# Model to use on that fallback path. Must exist on ollama.com.
FALLBACK_MODEL=gemma4:31b
