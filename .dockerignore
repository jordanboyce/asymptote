# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# Data directory (use volume instead)
data/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp

# Environment (secrets — never bake into images)
.env
.env.*
!.env.example
!.env.enterprise

# Documentation
*.md

# Tests
tests/
.pytest_cache/

# Docker (don't embed Docker configs inside image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Nginx config (mounted as volume, not baked in)
nginx/

# Desktop app (not needed in server image)
desktop/

# Frontend source (pre-built assets are in static/)
frontend/node_modules/

# SSL certs dir marker (actual certs handled by Dockerfile COPY)
nginx/ssl/
