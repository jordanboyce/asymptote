# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# Data directory (use volume instead)
data/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp

# Environment (secrets — never bake into images)
.env
.env.*
!.env.example

# Documentation
*.md

# Tests
tests/
.pytest_cache/

# Docker (don't embed Docker configs inside image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Frontend dependencies & local builds (installed/built inside the image)
frontend/node_modules/
frontend/dist/
